{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v zsh >/dev/null 2>&1 || exit 0; exec zsh \"${CLAUDE_PLUGIN_ROOT}/scripts/prompt-hook.sh\""
          }
        ]
      }
    ]
  }
}
